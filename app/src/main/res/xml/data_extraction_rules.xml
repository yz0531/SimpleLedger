<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Keep sensitive ledger data out of cloud backup. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="exports/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- The encrypted password is unusable without its non-transferable Android Keystore key. -->
        <exclude domain="sharedpref" path="nutstore_backup.xml" />
    </device-transfer>
</data-extraction-rules>
